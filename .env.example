# Copy to .env (repo root; loaded by grocer-server from its working dir).
# Real environment variables override these.

# Postgres connection
DATABASE_URL=postgres://grocer:grocer@localhost:5435/grocer

# Bind address. Default 127.0.0.1 (loopback only — the safe default for a
# self-hosted single instance). Set to 0.0.0.0 to serve the LAN, or a
# specific interface address, e.g. 192.168.2.218.
HOST=127.0.0.1

PORT=8787
